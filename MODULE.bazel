# rules_jsonnet's own crate.from_specs() call (for fetching a jrsonnet
# binary) is missing both a `lockfile = ...` and a `cargo_lockfile = ...`
# argument, which breaks `bazel mod graph` (and anything else that forces
# full evaluation of the shared crate_universe extension). Without
# `lockfile`: "crate_universe extension call `crates_jsonnet` is in a
# non-root module but has no lockfile" (non-root consumers can never repin,
# so rules_rust requires one to be shipped). Without `cargo_lockfile`: the
# underlying `cargo-bazel generate` binary hard-requires `--cargo-lockfile`
# regardless — closest upstream report is
# https://github.com/bazelbuild/rules_rust/issues/3783, whose "touch the
# lockfile" workaround only works for root-module consumers (repinning
# regenerates a real cargo_lockfile via splicing there); non-root
# consumption never repins, so that workaround can't apply here.
#
# Both lockfiles carry real, generated data (181 resolved crates), not
# placeholders: an empty `lockfile` would just be re-rendered from nothing
# on a root module, but non-root consumption trusts it as-is, so it has to
# already be correct. Generated by running rules_jsonnet 0.7.2 as its own
# root module with CARGO_BAZEL_REPIN=1 (for `lockfile`, the cargo-bazel
# format) and by translating that same resolution into a real Cargo.lock
# v4 (for `cargo_lockfile`, since from_specs has no Cargo.toml/Cargo.lock
# pair of its own to reuse) — see
# patches/rules_jsonnet/lockfile-content.diff and
# patches/rules_jsonnet/cargo-lock-content.diff. `skip_cargo_lockfile_overwrite`
# stops `cargo-bazel` from trying to rewrite that file back into the
# (supposedly read-only, patched-in) external repo on every evaluation.
#
# Must be `patches` diffs, not `patch_cmds`: bzlmod's early module-graph
# discovery reads a module's MODULE.bazel (to find its own tag calls, like
# this one) via patch application, but doesn't run patch_cmds — those only
# apply once the repo is fully materialized for BUILD-time use, by which
# point extension evaluation has already read the unpatched tag call. The
# lockfiles' actual content is only read at that later, full-materialization
# stage, so each is a separate patch (that early reader chokes on a diff
# touching more than just MODULE.bazel).
single_version_override(
    module_name = "rules_jsonnet",
    patches = [
        "//:patches/rules_jsonnet/lockfile.diff",
        "//:patches/rules_jsonnet/lockfile-content.diff",
        "//:patches/rules_jsonnet/cargo-lock-content.diff",
    ],
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "cc_mvdan_gofumpt",
    "com_github_bazelbuild_buildtools",
    "com_github_elastic_go_elasticsearch_v8",
    "com_github_kballard_go_shellquote",
    "com_github_prometheus_client_golang",
    "com_github_stretchr_testify",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_lint",
    "org_uber_go_mock",
)

go_deps_dev = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps_dev.gazelle_override(
    build_file_generation = "on",
    path = "github.com/cncf/xds/go",
)
go_deps_dev.module_override(
    patches = ["@com_github_buildbarn_bb_storage//:patches/com_github_grpc_ecosystem_go_grpc_prometheus/client-metrics-prevent-handled-twice.diff"],
    path = "github.com/grpc-ecosystem/go-grpc-prometheus",
)
go_deps_dev.module_override(
    patches = ["@com_github_buildbarn_bb_storage//:patches/org_golang_google_genproto_googleapis_bytestream/service-registrar.diff"],
    path = "google.golang.org/genproto/googleapis/bytestream",
)
go_deps_dev.module_override(
    patches = ["@com_github_buildbarn_bb_storage//:patches/org_golang_x_lint/generic.diff"],
    path = "golang.org/x/lint",
)
go_deps_dev.module_override(
    patches = ["@com_github_buildbarn_bb_storage//:patches/org_golang_x_sys/o-search.diff"],
    path = "golang.org/x/sys",
)
go_deps_dev.module_override(
    patches = ["@com_github_buildbarn_bb_storage//:patches/cc_mvdan_gofumpt/unused-receiver-idents.diff"],
    path = "mvdan.cc/gofumpt",
)
go_deps_dev.module_override(
    patches = [
        # "@com_github_buildbarn_bb_storage//:patches/org_uber_go_mock/generics.diff",
        "@com_github_buildbarn_bb_storage//:patches/org_uber_go_mock/mocks-for-funcs.diff",
    ],
    path = "go.uber.org/mock",
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    llvm_version = "14.0.0",
)
use_repo(llvm, "llvm_toolchain_llvm")

# Registers a Rust toolchain for the host platform (linux_amd64 on our CI
# runners). Cross-compiled release platforms are a separate, later step —
# not set up here yet.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Vendors the cmd/re_memoize + cmd/re_dispatch + lib/reapi Cargo workspace's
# dependencies as Bazel targets. `manifests` only needs the root workspace
# Cargo.toml, not each member's — cargo_bazel resolves the full workspace
# member graph from it, the same way `cargo metadata` would.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")
